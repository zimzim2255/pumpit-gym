# ═══════════════════════════════════════════════════════════════════════════════
#  GymDoorConnector - Environment Template
#  Copy to <connector>/.env  then fill in the values.
#  The connector never hard-codes secrets. Keep this file OUT of git.
# ═══════════════════════════════════════════════════════════════════════════════

# Required ─────────────────────────────────────────────────────────────────────
# Supabase edge function that validates members/subscriptions (NEW gym project):
SUPABASE_WEBHOOK_URL=https://lbbwmwyfthvdnwofqakp.supabase.co/functions/v1/zkteco-webhook

# Secret shared between the connector and the webhook (sent as "Authorization: Bearer ...").
# Supabase's secret store does NOT allow names starting with "SUPABASE_",
# so store it on Supabase as:  ZKTECO_WEBHOOK_SECRET
# (webhook also accepts WEBHOOK_SECRET / GYM_DOOR_SECRET).
# Put the SAME value here:
ZKTECO_WEBHOOK_SECRET=replace-me-with-a-long-random-secret

# Identifier used by Supabase to know which PC delivered the event.
CONNECTOR_ID=GYM_PC_001

# ─── Optional: CVAccess Open API (polling source) ─────────────────────────────
# Keep DISABLED unless you explicitly want polling in addition to the push.
CVAACCESS_OPENAPI_ENABLED=false
CVAACCESS_BASE_URL=http://127.0.0.1:8098
CVAACCESS_APP_CODE=
CVAACCESS_APP_SECRET=
CVAACCESS_TEMP_CODE=

# ─── CVAccess Cloud Settings / CVConnect push receiver (MAIN source) ──────────
# CVAccess "Cloud Settings" pushes access events to the URL below. The connector
# listens on this port (never 8088) to receive them.
# New gym = 2 doors, set the SAME URL in the CVAccess console:
#   System → System Management → Cloud Settings → "ZKBio CVConnect Server Url"
#     http://127.0.0.1:8091   (if the field accepts http://, recommended - no cert)
#     https://127.0.0.1:8091  (https only -> tools/make-cert.bat + import cert.pem)
CVACCESS_PUSH_ENABLED=true
CVACCESS_PUSH_PORT=8091
CVACCESS_PUSH_SCHEME=http
CVACCESS_PUSH_CAPTURE_FIRST=true

# ─── Optional: read-only SQL Server watcher (experimental, see README) ────────
#CVACCESS_DB_ENABLED=false
#CVACCESS_DB_SERVER=localhost
#CVACCESS_DB_NAME=
#CVACCESS_DB_USER=
#CVACCESS_DB_PASS=
#CVACCESS_DB_QUERY=SELECT TOP 100 * FROM dbo.vTransLog ORDER BY auto_id DESC

# ─── Access-sync: drive CVAccess local user state from OUR database ───────────
# The terminal fires the relay on a LOCAL match, so to actually LOCK someone out
# we must change their state in the CVAccess local DB (the terminal's source).
# Access-sync reads the Supabase allow-list and writes enable/lock + end-date
# into CVAccess local PostgreSQL. OFF until the schema is confirmed on-site:
#   powershell -ExecutionPolicy Bypass -File tools\probe-cvaccess.ps1
ACCESS_SYNC_ENABLED=false
ACCESS_SYNC_INTERVAL_MS=300000
ALLOWED_MEMBERS_URL=https://lbbwmwyfthvdnwofqakp.supabase.co/functions/v1/allowed-members
ACCESS_SYNC_DB_ENABLED=false
CVACCESS_DB_HOST=127.0.0.1
CVACCESS_DB_PORT=5442
CVACCESS_DB_DATABASE=
CVACCESS_DB_USER=
CVACCESS_DB_PASS=
# Queries below must be built from the REAL schema found on the gym PC:
#   {{userId}} placeholder is required; {{enabled}}/{{expiryDate}} are optional.
CVACCESS_DB_LIST_QUERY=
CVACCESS_DB_ENABLE_UPDATE=
CVACCESS_DB_DISABLE_UPDATE=
# Optional: local "may this user enter?" API (same decision as the webhook).
DECISION_API_ENABLED=false
DECISION_API_PORT=8092
# ─── Behaviour ─────────────────────────────────────────────────────────────────
GDC_DEDUP_WINDOW_SECONDS=300
GDC_LOG_LEVEL=info
GDC_LOG_MAX_DAYS=14