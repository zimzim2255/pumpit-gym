{
  "connector": {
    "id": "${CONNECTOR_ID:-GYM_PC_001}",
    "logLevel": "${GDC_LOG_LEVEL:-info}",
    "logMaxDays": "${GDC_LOG_MAX_DAYS:-14}"
  },
  "dedupe": {
    "windowSeconds": "${GDC_DEDUP_WINDOW_SECONDS:-300}",
    "maxKeys": 5000
  },
  "retry": {
    "initialDelayMs": 1500,
    "maxDelayMs": 600000,
    "factor": 3,
    "maxAttempts": 15,
    "sweepIntervalMs": 2000
  },
  "webhook": {
    "url": "${SUPABASE_WEBHOOK_URL:}",
    "secret": "${ZKTECO_WEBHOOK_SECRET:}",
    "timeoutMs": 15000,
    "maxBodyBytes": 16384,
    "acceptedStatusCodes": [200, 201, 202]
  },
  "accessControl": {
    "allowedMethods": ["fingerprint"],
    "allowedEventTypes": ["ACCESS", "CHECK_IN"],
    "verifyModeMap": {
      "1": "fingerprint",
      "2": "face",
      "3": "rfid",
      "4": "qr",
      "5": "password"
    }
  },
"control": {
    "enabled": "${ACCESS_SYNC_ENABLED:-false}",
    "syncIntervalMs": "${ACCESS_SYNC_INTERVAL_MS:-300000}",
    "allowedList": {
      "url": "${ALLOWED_MEMBERS_URL:-}"
    },
    "cvaccessDb": {
      "enabled": "${ACCESS_SYNC_DB_ENABLED:-false}",
      "driver": "psql",
      "bin": "psql",
      "host": "${CVACCESS_DB_HOST:-127.0.0.1}",
      "port": "${CVACCESS_DB_PORT:-5442}",
      "database": "${CVACCESS_DB_DATABASE:-}",
      "user": "${CVACCESS_DB_USER:-}",
      "password": "${CVACCESS_DB_PASS:-}",
      "listQuery": "${CVACCESS_DB_LIST_QUERY:-}",
      "enableUpdateQuery": "${CVACCESS_DB_ENABLE_UPDATE:-}",
      "disableUpdateQuery": "${CVACCESS_DB_DISABLE_UPDATE:-}"
    },
    "decisionApi": {
      "enabled": "${DECISION_API_ENABLED:-false}",
      "listenHost": "127.0.0.1",
      "listenPort": "${DECISION_API_PORT:-8092}"
    }
  },
  "sources": {
    "cvaccessOpenApi": {
      "enabled": "${CVAACCESS_OPENAPI_ENABLED:-false}",
      "pollIntervalMs": 3000,
      "baseUrl": "${CVAACCESS_BASE_URL:}",
      "auth": {
        "mode": "tempCode",
        "appCode": "${CVAACCESS_APP_CODE:}",
        "appSecret": "${CVAACCESS_APP_SECRET:}",
        "tempCode": "${CVAACCESS_TEMP_CODE:}",
        "tempTokenEndpoint": "/api/token/temp",
        "tokenEndpoint": "/api/token",
        "tokenField": "accessToken",
        "expiresInField": "expiresIn"
      },
      "eventFetch": {
        "method": "POST",
        "endpoint": "/api/att/getAttLogs",
        "pageSize": "pageSize",
        "pageNum": "pageNum",
        "sinceParam": "startTime",
        "endTimeParam": "endTime",
        "sinceField": "recordTimeStr",
        "dataPath": "data.list",
        "maxPages": 10
      },
      "mapping": {
        "deviceId": "sn",
        "userId": "employeeNo",
        "timestamp": "recordTimeStr",
        "method": "verifyType",
        "eventType": "event",
        "eventId": "id"
      },
      "staticFields": {
        "source": "cvaccess-openapi"
      }
    },
    "cvaccessPush": {
      "enabled": "${CVACCESS_PUSH_ENABLED:-true}",
      "scheme": "${CVACCESS_PUSH_SCHEME:-http}",
      "listenHost": "0.0.0.0",
      "listenPort": "${CVACCESS_PUSH_PORT:-8091}",
      "maxBodyBytes": 131072,
      "captureFirst": "${CVACCESS_PUSH_CAPTURE_FIRST:-true}",
      "mapping": {
        "deviceId": "deviceSn",
        "userId": "reId",
        "timestamp": "eventTime",
        "method": "verifyType",
        "eventType": "eventName",
        "eventId": "id"
      },
      "staticFields": {
        "source": "cvaccess-push"
      }
    },
    "cvaccessDb": {
      "enabled": false,
      "pollIntervalMs": 5000,
      "sqlcmdPath": "sqlcmd",
      "server": "${CVACCESS_DB_SERVER:}",
      "database": "${CVACCESS_DB_NAME:}",
      "user": "${CVACCESS_DB_USER:}",
      "password": "${CVACCESS_DB_PASS:}",
      "trustedConnection": true,
      "query": "${CVACCESS_DB_QUERY:}",
      "sinceField": "auto_id",
      "mapping": {
        "deviceId": "terminalid",
        "userId": "userid",
        "timestamp": "recordtime",
        "method": "verifymode",
        "eventType": "eventType",
        "eventId": "auto_id"
      },
      "eventFields": {
        "source": "cvaccess-db"
      }
    },
    "cvaccessPg": {
      "enabled": "${CVACCESS_PG_ENABLED:-true}",
      "pollIntervalMs": "${CVACCESS_PG_POLL_MS:-1000}",
      "bin": "${CVACCESS_PG_BIN:-}",
      "host": "${CVACCESS_DB_HOST:-127.0.0.1}",
      "port": "${CVACCESS_DB_PORT:-5442}",
      "database": "${CVACCESS_DB_DATABASE:-biosecurity-boot}",
      "user": "${CVACCESS_DB_USER:-root}",
      "password": "${CVACCESS_DB_PASS:-}",
      "query": "SELECT log_id, pin, event_time, dev_sn, dev_alias, event_no, event_name, verify_mode_no, verify_mode_name FROM public.acc_transaction WHERE log_id > {{since}} ORDER BY log_id ASC LIMIT 100"
    },
    "mockFingerprint": {
      "enabled": false,
      "intervalMs": 10000,
      "users": ["ADH001"],
      "deviceId": "TERMINAL_001"
    }
  }
}